# ══════════════════════════════════════════════════════════════════
# Red Avo — deployment environment
# Copy to `.env` next to docker-compose.yml and fill in real values.
# `.env` is git-ignored; never commit it.
# ══════════════════════════════════════════════════════════════════

# ─── Public URLs (set these to your VPS IP or domain) ─────────────
# Baked into the frontend at image-build time; changing them requires
# `docker compose up -d --build`.
# Browser-facing URL of the backend API (must be reachable from users' browsers)
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8080/api
# Browser-facing URL of pos-web (serves product images from /uploads)
NEXT_PUBLIC_MEDIA_URL=http://YOUR_VPS_IP:5000
# Browser-facing URL of storefront-web (used for Paynow return/result URLs)
NEXT_PUBLIC_BASE_URL=http://YOUR_VPS_IP:5001

# Comma-separated origins allowed to call the backend (the two frontend URLs)
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP:5000,http://YOUR_VPS_IP:5001

# ─── Host ports (optional; defaults shown) ────────────────────────
# If you change one, update the matching URL + CORS lines above too.
# Note: macOS uses 5000 for AirPlay Receiver — locally set POS_WEB_PORT=5002.
#POS_WEB_PORT=5000
#STOREFRONT_PORT=5001
#BACKEND_PORT=8080

# ─── Database (container-internal; pick any strong password) ──────
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Backend secrets ──────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=
# Super-password required to create the first ADMIN account
SUPER_PASSWORD=
# local | staging | production
APP_PROFILE=production
# Demo/seed data — keep false in production
SEED_ENABLED=false
# Swagger UI — keep false in production
SWAGGER_ENABLED=false

# ─── Backend mail (Gmail App Password, spaces removed) ────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Admin order alerts (optional; blank = disabled) ──────────────
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=

# ─── Twilio SMS (optional) ────────────────────────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Meta WhatsApp Cloud API (optional) ───────────────────────────
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# ─── Storefront contact form (Gmail SMTP, server-side) ────────────
SMTP_USER=
SMTP_PASSWORD=

# ─── Paynow payments (storefront, server-side) ────────────────────
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
